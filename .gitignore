# 产物
output/
*.log
__pycache__/
*.pyc

# 看门狗：targets.conf 是 servers.json 的派生物，由 gen_targets.py 生成，不入库
watchdog/targets.conf

# FLUX 对外服务运行时数据（不入库）
data/
web_out/
manager/tmp_web_prompts.json
manager/_owner_openid.txt
manager/flux_service.out

# 密钥/配置（绝不入库）
.env
*.token
server/prompts.json        # 业务提示词不入库，用 example 模板

# 系统
.DS_Store
Thumbs.db
# tests/manual 是一次性验证脚本目录：脚本入库，产物不入库
tests/manual/_*

# 本地备份目录（改动既有文件前建的 md5 基线快照，不入库）
.backup-*/
