# ============================================================
#  FLUX 文生图服务 配置样例
#  实际配置写到 manager/.env（已被 .gitignore 排除，绝不入库）
#  本文件只列 key，不含任何真实密钥
#
#  读取方式：feishu_notify._load_env() 用 os.environ.setdefault 灌入，
#            **真实环境变量优先于 .env**。flux_queue / flux_server_manager /
#            flux_resident_client 在模块级已显式调用 _load_env()。
# ============================================================

# ── 飞书通知（已有，勿改）──
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_OWNER_OPEN_ID=

# ── 飞书「图图」群聊（2026-09-28 新增，v2.11.0）──
# 决策：只服务 owner 自己 + **owner 自己的群**，且群里必须 **@图图** 才会响应。
#
# ① 允许服务的群 chat_id（逗号或分号分隔可写多个）。
#    ⚠️ **默认空 = 一个群都不服务** —— 刻意的安全默认：宁可"配了才生效"，
#       也不要"忘了配就对外裸奔"。要开群聊必须显式登记。
#    怎么拿群 chat_id：把图图拉进群后随便 @ 它一次，看 manager 日志里
#    「🤖 群 <chat_id> 不在白名单（FEISHU_ALLOWED_CHATS），忽略」这行即可。
# FEISHU_ALLOWED_CHATS=oc_xxxxxxxxxxxxxxxx

# ② 图图**自己的** open_id（判断群里 @ 的是不是它本人）。
#    不配也能跑，但 @ 判定会**退化为"任意 @ 即响应"**（会误响应 @别人 的消息），
#    所以配了更好。拿法：飞书开放平台 → 凭证与基础信息，或看一次日志里的 mentions。
# FEISHU_BOT_OPEN_ID=ou_xxxxxxxxxxxxxxxx

# ── 飞书「图图」提交前确认（2026-09-28 新增，v2.12.0）──
# 用户发来的消息**不都是生图提示词**（可能随口一句 / 打错字），
# 所以非命令文本**不再直接出图**：先回一条确认（带本次参数），
# 用户回「是」才建任务；回「否」放弃；5 分钟不回自动作废（不扣额度）。
#
# 默认**开**（不写这一行也是开）。要回退旧行为（发一句就出图）才需要显式写 0。
# ⚠️ 显式留空（FIGU_CONFIRM_SUBMIT=）按「未设」处理 = **开**，不是关 ——
#    避免配置文件里一行空值把功能静默关掉。
# FIGU_CONFIRM_SUBMIT=1

# ── 对外 web 服务（已有，勿改）──
# WEB_PORT=9620
# WEB_ADMIN_TOKEN=

# ── 生成路径选择（2026-09-16 新增）──
# resident = 常驻服务（默认）：模型加载一次常驻显存，之后每张图只做推理
# legacy   = 旧链路：每张图冷启动 gen_flux.py，重新加载 ~31GB 权重
# 代码默认就是 resident，不写这一行也是 resident。要回退旧链路才需要显式写 legacy。
# FLUX_GEN_MODE=resident

# ── 常驻服务连接（2026-09-16 新增）──
# 常驻服务端口（GPU 机本地监听，也是 SSH curl 的目标端口）
# FLUX_RESIDENT_PORT=9630

# 直连地址：**本机就能访问到常驻服务时**才填（本地部署模型 / 自己已开好 ssh -L 隧道）
# 留空 = 走 SSH：管理器直接 `ssh <alias> 'curl http://127.0.0.1:9630/...'`，无需端口转发
# FLUX_RESIDENT_BASE=http://127.0.0.1:9630

# 共享令牌；服务端设了 FLUX_RESIDENT_TOKEN 时这里必须一致，否则 401
# FLUX_RESIDENT_TOKEN=

# ── 常驻服务启动参数（2026-09-16 新增）──
# 显存策略：none=全程显存（最快，需装得下整模型）/ model=模型级 offload（快 2~3 倍于 sequential）/ sequential=最省
# 建议先 none；OOM 退 model；再 OOM 用 sequential
# FLUX_OFFLOAD=none

# 远端 python 解释器（带 torch/diffusers 的环境）
# FLUX_RESIDENT_PY=/root/miniconda3/envs/flux/bin/python

# 远端 screen 会话名（勿与旧链路的 fluxgen 重名）
# FLUX_RESIDENT_SCREEN=fluxd

# 等首次模型加载的上限秒数（默认 900）。只影响冷启动那一次
# FLUX_RESIDENT_WAIT_MODEL=900

# 常驻没起来时是否自动拉起（默认 1）。设 0 = 只报错不自动启动，便于人工控场
# FLUX_RESIDENT_AUTOSTART=1

# 改过 server/flux_resident_server.py 后，设 1 可强制重传脚本并重启常驻服务
# FLUX_RESIDENT_SYNC=1

# 队列上限 / 单任务最多恢复次数（已有）
# FLUX_QUEUE_MAX=50

# ── 多机 / 自动选在线机（2026-09-16 新增）──
# 背景：有时服务器没 GPU，需要换到有卡的机器，甚至把整个实例克隆到新服务器。
#      候选机 = 显式注册的 flux1/flux2/flux3 + ~/.ssh/config 中匹配下面模式的别名，
#      探测后按「常驻已加载 > 可达有卡有模型 > 可达有卡 > 可达」分级自动选一台。
#
# 默认机 = 不带 --server 时用的那台，也是小红书产线（process_job）走的那台。
# 不填 = 候选机第一台（flux1）。当第一台「开机但没卡」时，填 flux3 即可把默认机指过去。
# 只改「默认值」，不影响 A 链（任务中心每单自己挑可用机）。
# FLUX_DEFAULT_SERVER=flux3
#
# 关掉自动发现（只留显式注册的三台）。调试对比行为时用。
# FLUX_SERVER_DISCOVER=1

# 别名匹配模式，逗号分隔可写多个。默认只认 autodl-flux*。
# 克隆机若起了别的名字（例如 autodl-clone-gpu），把它加进来即可 —— 不用改代码。
# 不知道自己有哪些别名：跑 `python manager/flux_resident_client.py servers`，
# 输出末尾会把「未纳入的别名」列出来。
# FLUX_SERVER_ALIAS_GLOB=autodl-flux*

# 克隆实例的工作目录 / 模型路径（克隆机与原机同布局，用这两个兜底）
# FLUX_REMOTE_BASE=/root/autodl-tmp/flux-t2i
# FLUX_REMOTE_MODEL=/root/autodl-tmp/models/FLUX.1-dev

# 探测结果缓存秒数（默认 20，设 0 关闭）。
# 选机逻辑每张图都会调，不缓存则候选机一多就是每张图 N 次 SSH。
# 代价：机器刚开机最多晚 TTL 秒被认出来。
# FLUX_PROBE_TTL=20

# ── 配额退还（2026-09-16 新增，无需配置，仅说明语义）──
# 任务进入**终态失败**（业务失败 / 重试超限）时自动退还 1 张配额，靠 jobs.refunded_at 保证幂等。
# waiting（服务器 down 等恢复）**不退** —— 它不是终态，任务恢复后会继续跑。
